{
  "name": "jelovnik-uc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Јеловник Ученичког центра Београд: аутоматско преузимање PDF-а, бесплатна OCR обрада, PWA приказ и push обавештења.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test \"test/*.test.js\"",
