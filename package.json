    "seed": "node scripts/ingest-once.js --fixture fixtures/jelovnik-2026-09-I.json",
    "verify": "node scripts/verify-ocr.js",
    "vapid": "node scripts/gen-vapid.js",
    "icons": "node scripts/gen-icons.js",
