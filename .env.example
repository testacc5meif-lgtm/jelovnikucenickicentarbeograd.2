# --- Обавезно ---
# VAPID кључеви за Web Push. Генеришу се једном: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@example.rs

# --- Опционо ---
PORT=3000
# Јавни URL апликације (користи се у нотификацијама за отварање)
PUBLIC_URL=http://localhost:3000
# Страница са које се преузима PDF
SOURCE_URL=https://www.ucenickicentar-bg.rs/sluzba-ishrane/
# OCR: путања до Tesseract-а, директоријум са језичким подацима и језик
TESSERACT_BIN=tesseract
TESSDATA_DIR=./tessdata
OCR_LANG=srp
# База. Ако је DATABASE_URL подешен, ради Postgres, иначе SQLite фајл.
# За Supabase узми "Connection string" из подешавања пројекта.
# DATABASE_URL=postgresql://postgres.xxxx:LOZINKA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# DATABASE_SSL=true
DB_PATH=./data/jelovnik.db
# Временска зона за распоред обавештења
TZ_NAME=Europe/Belgrade
# Cron израз за проверу сајта (подразумевано: сваког сата у минуту 7)
CHECK_CRON=7 * * * *
# Токен за ручно окидање обраде преко /api/admin/ingest
ADMIN_TOKEN=

# Распоред послова. "internal" држи га у процесу, што важи за сервер који
# стално ради. "off" га гаси, за хостинг који услугу успављује; тада
# послове позива спољни сервис преко рута под /api/cron.
SCHEDULER=internal
# Тајна коју спољни сервис шаље у заглављу x-cron-secret. Док је празна,
# те руте не постоје.
CRON_SECRET=
